{
  "name": "econsim",
  "version": "1.0.0",
  "description": "Country & economy simulator on a 3D globe: 197 countries, government/citizen/corporate agents, real trade, currencies, stock markets, crypto, scenarios and ensemble uncertainty.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lionl1/econsim.git"
  },
  "keywords": [
    "simulation",
    "economics",
    "agent-based-model",
    "globe",
    "three.js",
    "trade",
    "scenarios"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "dev": "vite",
    "build": "vite build",
    "data": "python3 scripts/fetch_data.py",
    "calibrate": "node scripts/calibrate.mjs",
    "backtest": "node scripts/backtest.mjs",
    "ensemble": "node scripts/ensemble.mjs",
    "history": "python3 scripts/fetch_history.py",
    "trade": "python3 scripts/fetch_trade.py",
    "markets": "python3 scripts/fetch_markets.py",
    "sim": "node scripts/headless.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  },
  "author": ""
}
